// Cloudflare Workers static-assets deploy for the Phase 1 prototype (no server code, no secrets).
// Serves the canvas prototype boards in apps/prototype/site.
{
  "name": "finvora",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/prototype/site",
    "not_found_handling": "404-page"
  }
}
